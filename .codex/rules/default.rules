prefix_rule(
    pattern = ["git", "push"],
    decision = "forbidden",
    justification = "In this repo the user pushes, never an agent. Ask the user to run it.",
    match = ["git push origin main", "git push --force origin main", "git push --delete origin x"],
    not_match = ["git status", "git log --oneline -5"],
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Discards commits and working-tree changes that may be someone else's.",
    match = ["git reset --hard HEAD~1"],
    not_match = ["git reset --soft HEAD~1"],
)

prefix_rule(
    pattern = ["git", "clean"],
    decision = "forbidden",
    justification = "Deletes untracked files, which may be someone's unsaved work.",
    match = ["git clean -fd"],
    not_match = ["git status"],
)

prefix_rule(
    pattern = ["git", "rebase"],
    decision = "forbidden",
    justification = "Rewrites shared history. Ask the user to run it.",
    match = ["git rebase main"],
    not_match = ["git log --oneline main..HEAD"],
)

prefix_rule(
    pattern = ["git", "filter-branch"],
    decision = "forbidden",
    justification = "Rewrites all of history. Ask the user to run it.",
    match = ["git filter-branch --tree-filter x"],
    not_match = ["git log"],
)

prefix_rule(
    pattern = ["git", "update-ref", "-d"],
    decision = "forbidden",
    justification = "Deletes a ref outside the normal branch/tag commands.",
    match = ["git update-ref -d refs/heads/x"],
    not_match = ["git update-ref -h"],
)

prefix_rule(
    pattern = ["git", "checkout", "--"],
    decision = "forbidden",
    justification = "Discards working-tree changes to named files that may be someone else's.",
    match = ["git checkout -- Sources/countersign/AppDelegate.swift"],
    not_match = ["git checkout -b feat/x"],
)

prefix_rule(
    pattern = ["git", "restore", "."],
    decision = "forbidden",
    justification = "Discards all working-tree changes, which may be someone else's.",
    match = ["git restore ."],
    not_match = ["git restore --staged Package.swift"],
)

prefix_rule(
    pattern = ["gh", "repo", "delete"],
    decision = "forbidden",
    justification = "Deletes a GitHub repository. Ask the user to run it.",
    match = ["gh repo delete x/y"],
    not_match = ["gh repo view"],
)

prefix_rule(
    pattern = ["gh", "release", "delete"],
    decision = "forbidden",
    justification = "Deletes a published release. Ask the user to run it.",
    match = ["gh release delete v0.22.0"],
    not_match = ["gh release list"],
)

prefix_rule(
    pattern = ["gh", "auth", ["switch", "logout"]],
    decision = "forbidden",
    justification = "Changes or drops the user's GitHub session.",
    match = ["gh auth switch", "gh auth logout"],
    not_match = ["gh auth status"],
)

prefix_rule(
    pattern = ["security", ["find-generic-password", "find-internet-password"]],
    decision = "forbidden",
    justification = "Reads a saved credential from the login keychain.",
    match = ["security find-generic-password -s x"],
    not_match = ["security list-keychains"],
)

prefix_rule(
    pattern = ["sudo", "rm"],
    decision = "forbidden",
    justification = "Deletes files as root.",
    match = ["sudo rm -rf /var/x"],
    not_match = ["sudo -v"],
)

prefix_rule(
    pattern = [
        [
            "countersign",
            ".build/debug/countersign",
            ".build/release/countersign",
            "./.build/debug/countersign",
            "./.build/release/countersign",
            ".build/Countersign.app/Contents/MacOS/countersign",
            "~/.local/bin/countersign",
        ],
        ["hook", "preview", "setup", "settings", "pause", "resume", "snooze"],
    ],
    decision = "prompt",
    justification = "Touches live approval config or shows an on-screen panel; check with the user first.",
    match = [
        "countersign hook",
        ".build/debug/countersign setup",
        "./.build/release/countersign hook --host claude",
        "countersign snooze 15m",
    ],
    not_match = [".build/debug/countersign snapshot x.json -o /tmp/x.png", ".build/debug/countersign status"],
)

prefix_rule(
    pattern = [["scripts/install.sh", "./scripts/install.sh"]],
    decision = "prompt",
    justification = "Installs the built binary onto the machine.",
    match = ["scripts/install.sh", "./scripts/install.sh"],
    not_match = ["scripts/check.sh"],
)

prefix_rule(
    pattern = ["scripts/worktree-cleanup.sh", "--other-sessions"],
    decision = "prompt",
    justification = "Removes worktrees other running sessions may still be using.",
    match = ["scripts/worktree-cleanup.sh --other-sessions"],
    not_match = ["scripts/worktree-cleanup.sh"],
)

prefix_rule(
    pattern = ["rm"],
    decision = "prompt",
    justification = "Deletes files that may be someone else's.",
    match = ["rm Sources/countersign/x.swift"],
    not_match = ["ls Sources"],
)

prefix_rule(
    pattern = ["rmdir"],
    decision = "prompt",
    justification = "Deletes a directory that may be someone else's.",
    match = ["rmdir build"],
    not_match = ["mkdir build"],
)

prefix_rule(
    pattern = [["kill", "pkill", "killall"]],
    decision = "prompt",
    justification = "Stops a process that may belong to another session, such as a running preview or dev build.",
    match = ["kill 4242", "pkill countersign", "killall countersign"],
    not_match = ["ps aux"],
)

prefix_rule(
    pattern = ["sudo"],
    decision = "prompt",
    justification = "Runs a command as root, which needs the user's sign-off.",
    match = ["sudo iconutil -c icns x.iconset", "sudo -v"],
    not_match = ["whoami"],
)

prefix_rule(
    pattern = ["git", "rm"],
    decision = "prompt",
    justification = "Removes a tracked file from the working tree and the index.",
    match = ["git rm AGENTS.md"],
    not_match = ["git status"],
)

prefix_rule(
    pattern = ["git", "restore"],
    decision = "prompt",
    justification = "Changes the shared working tree; git restore . is forbidden outright, other forms still need a check.",
    match = ["git restore --staged Package.swift", "git restore --worktree Sources/x.swift"],
    not_match = ["git status"],
)

prefix_rule(
    pattern = ["git", "stash", ["pop", "drop"]],
    decision = "prompt",
    justification = "Rewrites or discards entries on a stash stack shared with other sessions.",
    match = ["git stash pop", "git stash drop"],
    not_match = ["git stash list", "git stash show"],
)

prefix_rule(
    pattern = ["git", "switch"],
    decision = "prompt",
    justification = "Changes the checked-out branch of a tree other sessions may share.",
    match = ["git switch main"],
    not_match = ["git branch --show-current"],
)

prefix_rule(
    pattern = ["git", "checkout"],
    decision = "prompt",
    justification = "Changes the checked-out branch or files; discarding a specific file with -- is forbidden outright.",
    match = ["git checkout main", "git checkout -b feat/x", "git checkout -- Sources/x.swift"],
    not_match = ["git status"],
)

prefix_rule(
    pattern = ["git", ["merge", "apply", "am", "revert"]],
    decision = "prompt",
    justification = "Merges, patches, or reverts history; the result needs a look before it lands.",
    match = ["git merge feat/x", "git apply x.patch", "git am x.patch", "git revert abc123"],
    not_match = ["git diff"],
)

prefix_rule(
    pattern = ["git", "branch", ["-d", "-D"]],
    decision = "prompt",
    justification = "Deletes a branch, which may hold work not merged elsewhere.",
    match = ["git branch -d feat/x", "git branch -D feat/x"],
    not_match = ["git branch --show-current"],
)

prefix_rule(
    pattern = ["git", "worktree", ["remove", "prune"]],
    decision = "prompt",
    justification = "A worktree may hold the only copy of someone's work.",
    match = ["git worktree remove .claude/worktrees/x"],
    not_match = ["git worktree list"],
)

prefix_rule(
    pattern = ["git", "config"],
    decision = "prompt",
    justification = "Changes repository or user git configuration.",
    match = ["git config core.hooksPath scripts/git-hooks", "git config --get core.hooksPath"],
    not_match = ["git status"],
)

prefix_rule(
    pattern = ["git", "tag"],
    decision = "prompt",
    justification = "Creates or deletes a release tag.",
    match = ["git tag v0.22.0", "git tag -d v0.21.0", "git tag --list"],
    not_match = ["git status"],
)

prefix_rule(
    pattern = ["git", "remote", ["add", "set-url"]],
    decision = "prompt",
    justification = "Changes where a remote points.",
    match = ["git remote add upstream https://example.com/x.git"],
    not_match = ["git remote -v"],
)

prefix_rule(
    pattern = ["gh", "auth", "token"],
    decision = "prompt",
    justification = "Prints the user's GitHub credential.",
    match = ["gh auth token"],
    not_match = ["gh auth status"],
)

prefix_rule(
    pattern = ["gh", "repo", ["create", "edit"]],
    decision = "prompt",
    justification = "Writes to GitHub on the user's behalf.",
    match = ["gh repo edit --description x"],
    not_match = ["gh repo view"],
)

prefix_rule(
    pattern = ["gh", "release", ["create", "upload", "edit"]],
    decision = "prompt",
    justification = "Writes to GitHub on the user's behalf.",
    match = ["gh release create v0.22.0"],
    not_match = ["gh release list"],
)

prefix_rule(
    pattern = ["gh", "pr", ["create", "comment", "merge", "review"]],
    decision = "prompt",
    justification = "Writes to GitHub on the user's behalf.",
    match = ["gh pr create --fill", "gh pr merge 171"],
    not_match = ["gh pr view 171", "gh pr diff 171"],
)

prefix_rule(
    pattern = ["gh", "issue", ["create", "comment"]],
    decision = "prompt",
    justification = "Writes to GitHub on the user's behalf.",
    match = ["gh issue comment 12 --body x"],
    not_match = ["gh issue list"],
)

prefix_rule(
    pattern = ["gh", "workflow", "run"],
    decision = "prompt",
    justification = "Starts a CI run on the user's behalf.",
    match = ["gh workflow run ci.yml"],
    not_match = ["gh workflow list"],
)

prefix_rule(
    pattern = ["gh", ["secret", "variable"], "set"],
    decision = "prompt",
    justification = "Repository secrets and variables are managed by a person.",
    match = ["gh secret set TOKEN", "gh variable set NAME"],
    not_match = ["gh secret list"],
)

prefix_rule(
    pattern = ["gh", "api", ["-X", "--method"], ["POST", "PATCH", "PUT", "DELETE"]],
    decision = "prompt",
    justification = "A write through the GitHub API.",
    match = ["gh api -X POST repos/x/y/issues", "gh api --method DELETE repos/x/y"],
    not_match = ["gh api -X GET repos/x/y", "gh api repos/x/y"],
)

prefix_rule(
    pattern = ["brew", ["install", "uninstall", "tap"]],
    decision = "prompt",
    justification = "Installs or removes software on the machine.",
    match = ["brew install jq"],
    not_match = ["brew list"],
)

prefix_rule(
    pattern = ["npm", ["install", "i"]],
    decision = "prompt",
    justification = "New dependencies need the user's sign-off.",
    match = ["npm install", "npm i lodash"],
    not_match = ["npm view zod version"],
)

prefix_rule(
    pattern = ["npx"],
    decision = "prompt",
    justification = "Runs a downloaded package.",
    match = ["npx create-x"],
    not_match = ["ls"],
)

