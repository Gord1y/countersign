{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(scripts/check.sh)",
      "Bash(./scripts/check.sh)",
      "Bash(scripts/check-build.sh)",
      "Bash(scripts/check-test.sh)",
      "Bash(scripts/check-lint.sh)",
      "Bash(scripts/check-scripts.sh)",
      "Bash(scripts/test-release-index.sh)",
      "Bash(swift build*)",
      "Bash(swift test*)",
      "Bash(swift format*)",
      "Bash(.build/debug/countersign snapshot *)",
      "Bash(.build/debug/countersign status*)",
      "Bash(scripts/worktree-cleanup.sh)",
      "Bash(scripts/worktree-cleanup.sh *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git --no-pager log*)",
      "Bash(git --no-pager diff*)",
      "Bash(git --no-pager show*)",
      "Bash(git rev-parse*)",
      "Bash(git rev-list*)",
      "Bash(git merge-base*)",
      "Bash(git cherry *)",
      "Bash(git describe*)",
      "Bash(git shortlog*)",
      "Bash(git blame*)",
      "Bash(git branch)",
      "Bash(git branch -a)",
      "Bash(git branch -v)",
      "Bash(git branch -vv)",
      "Bash(git branch --list*)",
      "Bash(git branch --show-current)",
      "Bash(git for-each-ref*)",
      "Bash(git worktree list*)",
      "Bash(git worktree add *)",
      "Bash(git add *)",
      "Bash(git commit*)",
      "Bash(git cherry-pick*)",
      "Bash(git stash list*)",
      "Bash(git stash show*)",
      "Bash(git stash push*)",
      "Bash(git stash apply*)",
      "Bash(gh auth status*)",
      "Bash(gh repo view*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr checks*)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh workflow list*)",
      "Bash(gh workflow view*)",
      "Bash(gh release list*)",
      "Bash(gh release view*)",
      "Bash(gh api -X GET *)",
      "Bash(ls*)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(diff *)",
      "Bash(stat *)",
      "Bash(file *)",
      "Bash(which *)",
      "Bash(pwd)",
      "Bash(date*)",
      "Bash(jq *)",
      "Bash(plutil -p *)",
      "Bash(plutil -lint *)",
      "Bash(plutil -extract *)",
      "Bash(du *)",
      "Bash(basename *)",
      "Bash(dirname *)",
      "Bash(realpath *)",
      "mcp__context7"
    ],
    "deny": [
      "Bash(*gh auth switch*)",
      "Bash(*gh auth logout*)",
      "Bash(*git push*--force*)",
      "Bash(*git push* -f*)",
      "Bash(*git push*--mirror*)",
      "Bash(*git push*--delete*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git rebase*)",
      "Bash(git filter-branch*)",
      "Bash(git update-ref -d*)",
      "Bash(git checkout -- *)",
      "Bash(git restore .)",
      "Bash(*gh repo delete*)",
      "Bash(*gh release delete*)",
      "Bash(find * -delete*)",
      "Bash(find * -exec*)",
      "Bash(find * -ok*)",
      "Bash(find * -fprint*)",
      "Bash(sort *--compress-program*)",
      "Bash(rg *--pre*)",
      "Bash(rg *--hostname-bin*)",
      "Bash(*gh api -X GET * -X*)",
      "Bash(*gh api -X GET *--method*)",
      "Bash(scripts/worktree-cleanup.sh *--other-sessions*)",
      "Read(**/.env)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(~/.npmrc)",
      "Read(~/Library/Keychains/**)",
      "Read(~/.claude.json)",
      "Bash(cat ~/.ssh/*)",
      "Bash(cat ~/.netrc*)",
      "Bash(cat ~/.git-credentials*)",
      "Bash(security find-*)",
      "Bash(sudo rm *)",
      "Edit(**/.env)",
      "Bash(cat .env)",
      "Bash(cat */.env)"
    ]
  },
  "sandbox": {
    "excludedCommands": [
      "swift *",
      "scripts/check.sh",
      "./scripts/check.sh",
      "scripts/check-build.sh",
      "scripts/check-test.sh",
      "scripts/check-lint.sh",
      "scripts/check-scripts.sh",
      "scripts/test-release-index.sh",
      "scripts/build-app.sh *",
      "scripts/package-release.sh *",
      "scripts/install.sh",
      "scripts/screenshots/render.sh"
    ]
  }
}
