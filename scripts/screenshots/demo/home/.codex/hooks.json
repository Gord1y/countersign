{
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{EXECUTABLE}} hook --host codex",
            "timeout": 3600,
            "statusMessage": "Waiting for the approval panel"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{EXECUTABLE}} hook --host codex",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{EXECUTABLE}} hook --host codex",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{EXECUTABLE}} hook --host codex --event waiting",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
