{
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{EXECUTABLE}} hook --host claude",
            "timeout": 3600
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{EXECUTABLE}} hook --host claude --event waiting",
            "async": true,
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{EXECUTABLE}} hook --host claude",
            "async": true,
            "timeout": 3600
          }
        ]
      }
    ]
  }
}
