{
  "countersign": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{{EXECUTABLE}} hook --host antigravity",
            "timeout": 3600
          }
        ]
      }
    ]
  },
  "countersign-waiting": {
    "Stop": [
      {
        "type": "command",
        "command": "{{EXECUTABLE}} hook --host antigravity --event waiting",
        "timeout": 30
      }
    ]
  }
}
